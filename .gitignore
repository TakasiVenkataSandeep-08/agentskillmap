# Rust build artifacts
/target/

# Release staging. scripts/build-release.sh copies the binary to dist/, and
# scripts/npm-packages.sh assembles the publishable packages under npm-dist/.
# Both are outputs of a release run; npm/skillmap/ is the committed source they
# are built from.
/dist/
/npm-dist/

# Corpus raw data (may be large)
/corpus/raw/
# 43 MB for a single snapshot: one record per bundle across 34,000 of them.
# `report.md` is the published artifact and is committed; the index is the
# working data behind it and is regenerated by re-running the harvester.
/corpus/index.json
# The fetch ledger lives inside raw/ so one rule covers every non-published
# corpus artifact. index.json and report.md are deliberately NOT ignored: they
# are the published research output and belong in review.

# Environment variables
.env

# Coverage profiling data
*.profraw

# Python bytecode. scripts/ is run directly by CI and by the PostToolUse hooks,
# so __pycache__ appears during ordinary work. Committing it is not merely noise:
# a .pyc is binary, verify_spec.py's CRLF check reads every tracked non-binary
# file as text, and the byte pairs inside bytecode trip it — producing a false
# invariant-2 alarm on the repo's own determinism check.
__pycache__/
*.pyc
.venv/

# Merge and patch leftovers
*.orig
*.rej

# OS-specific noise
.DS_Store
Thumbs.db
