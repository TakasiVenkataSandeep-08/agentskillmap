{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakasiVenkataSandeep-08/agentskillmap/schema/manifest-v1.schema.json",
  "title": "skillmap capability manifest",
  "description": "Capability manifest for an AI agent skill bundle. Descriptive only: contains no risk score, grade, or safety judgement by design.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "target", "inventory", "disclosure", "capabilities", "instructions", "unresolved", "advisory", "diagnostics"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "resolver", "root", "content_digest"],
      "properties": {
        "kind": { "enum": ["skill", "plugin", "bundle"] },
        "name": { "type": "string" },
        "resolver": { "type": "string", "description": "Resolver id, e.g. claude-code" },
        "root": {
          "type": "string",
          "description": "Bundle root as a forward-slash path relative to the RESOLVER'S DISCOVERY ROOT, never to cwd or the project directory. Two machines with different checkout layouts must produce the same string."
        },
        "content_digest": {
          "$ref": "#/$defs/digest",
          "description": "Merkle root over the sorted inventory, covering file bytes only. See docs/02-manifest-schema.md for the exact construction."
        }
      }
    },
    "inventory": {
      "type": "array",
      "description": "Sorted by path, byte-wise over UTF-8.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "load_phase", "parsed_as", "parse_status"],
        "properties": {
          "path": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/digest" },
          "load_phase": {
            "enum": ["always", "on_trigger", "reference", "unreferenced"],
            "description": "When this file enters the agent's context. The always/reference gap is the disclosure signal."
          },
          "parsed_as": { "type": "string" },
          "parse_status": { "enum": ["ok", "error", "unsupported"] }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description_bytes", "declared_capabilities", "trigger_terms", "reference_files", "unreferenced_files"],
      "properties": {
        "description_bytes": { "type": "integer", "minimum": 0 },
        "declared_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Verbatim capability strings as declared in third-party frontmatter, sorted byte-wise. Deliberately NOT our closed taxonomy: this records what the author said, in their vocabulary. Mapping into capabilityTerm is a separate, explicitly lossy step and never happens silently."
        },
        "trigger_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Extracted, not scored. Sorted byte-wise."
        },
        "reference_files": { "type": "integer", "minimum": 0 },
        "unreferenced_files": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Tier: proven. Code-plane static analysis only. Sorted by (capability, first evidence file, first evidence start_byte).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "reachability", "evidence"],
        "properties": {
          "capability": { "$ref": "#/$defs/capabilityTerm" },
          "reachability": { "enum": ["observed", "present", "unresolved"] },
          "detail": { "$ref": "#/$defs/detail" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceStrict" } }
        }
      }
    },
    "instructions": {
      "type": "array",
      "description": "Tier: pattern. Lexical signals over prose. Deliberately weak; never promoted to capabilities. Sorted by (signal, first evidence file, first evidence start_byte).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "evidence"],
        "properties": {
          "signal": { "$ref": "#/$defs/instructionSignal" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceStrict" } }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "description": "Gaps in the analysis of the BUNDLE. Top-level so it stays visible when capabilities is empty. Sorted by (file, reason, start_byte), with an absent start_byte ordering before any present one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "file"],
        "properties": {
          "reason": {
            "enum": ["dynamic_dispatch", "computed_target", "indirect_call", "unsupported_language", "parse_error", "binary_file", "size_limit", "symlink_escape"]
          },
          "file": { "type": "string" },
          "start_byte": { "type": "integer", "minimum": 0 },
          "end_byte": { "type": "integer", "minimum": 0 },
          "start_line": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "advisory": {
      "type": "object",
      "description": "Tier: advisory. Model output. Cannot add to, remove from, or modify the deterministic branches. Findings sorted by (kind, first evidence file, first evidence start_line, claim).",
      "additionalProperties": false,
      "required": ["enabled", "findings"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "prompt_sha256": { "$ref": "#/$defs/digest" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "claim", "evidence"],
            "properties": {
              "kind": { "enum": ["disclosure_delta", "undeclared_instruction", "injection_attempt", "obfuscated_intent"] },
              "claim": { "type": "string" },
              "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceAdvisory" } }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "Invariant 6: the model id and prompt template hash are pinned whenever the pass ran, or the advisory branch is not reproducible and CI diffs become noise.",
          "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
          "then": { "required": ["model", "prompt_sha256"] }
        },
        {
          "$comment": "'Not checked' and 'checked, found nothing' must stay distinguishable in a diff. A disabled pass carries no findings and no pinning.",
          "if": { "required": ["enabled"], "properties": { "enabled": { "const": false } } },
          "then": {
            "properties": { "findings": { "maxItems": 0 } },
            "not": { "anyOf": [{ "required": ["model"] }, { "required": ["prompt_sha256"] }] }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "description": "Problems with the RUN, not with the bundle. Anything the analysis could not cover in the bundle belongs in `unresolved` instead. Sorted by (code, file).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "enum": ["rule_load_error", "rule_validation_error", "semantic_schema_violation", "semantic_call_failed", "policy_load_error"]
          },
          "file": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "description": "Closed by design: this object is part of a byte-identical artifact, so every key needs a declared type and sort order. Adding a key here is a schema-version event, same rule as adding a taxonomy term.",
      "properties": {
        "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Sorted byte-wise." },
        "hosts": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Sorted byte-wise." }
      }
    },
    "evidenceStrict": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance for the deterministic tiers (proven, pattern). Complete by requirement: a finding that cannot be pointed at cannot be regression-tested. Sorted by (file, start_byte).",
      "required": ["file", "start_byte", "end_byte", "start_line", "rule_id", "snippet_sha256"],
      "properties": {
        "file": { "type": "string" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 },
        "start_line": { "type": "integer", "minimum": 1 },
        "rule_id": { "type": "string" },
        "snippet_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceAdvisory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance for the advisory tier. File and line only: no rule fired, so there is no rule_id, and a byte span reconstructed from a model's prose citation would be manufactured precision. Structurally cannot carry rule_id or snippet_sha256. Sorted by (file, start_line).",
      "required": ["file", "start_line"],
      "properties": {
        "file": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilityTerm": {
      "enum": [
        "process.exec",
        "process.exec.dynamic",
        "net.egress",
        "net.fetch_then_execute",
        "fs.read.credential",
        "fs.read.outside_bundle",
        "fs.write.outside_bundle",
        "fs.write.agent_config",
        "code.dynamic_eval",
        "code.obfuscation",
        "env.read.secret"
      ]
    },
    "instructionSignal": {
      "enum": [
        "instruction.fetch_as_instruction",
        "instruction.exfil",
        "instruction.config_mutation",
        "instruction.silence",
        "instruction.privilege_claim",
        "instruction.exec_directive"
      ]
    }
  }
}
